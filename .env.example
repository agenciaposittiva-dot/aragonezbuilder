# ---------------------------------------------------------------
# Aragonez Builder · variáveis de ambiente
# Copie para .env e ajuste. Nunca faça commit do .env.
# ---------------------------------------------------------------

# URL pública da aplicação (usada em links de e-mail e URLs assinadas).
# Na Vercel pode ficar em branco: usa o endereço do próprio deploy.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Aragonez Builder"

# Banco de dados
# DATABASE_URL: papel de execução, SEM superusuário e SEM BYPASSRLS (as políticas RLS se aplicam)
# DATABASE_OWNER_URL: papel dono das tabelas; usado só por migrações, seed e pelo worker (pg-boss)
# Com um único usuário (ex.: banco Neon criado pela Vercel), basta DATABASE_URL: as
# migrações criam o papel "aragonez_rls" e a aplicação o assume em cada transação.
# Também são aceitos POSTGRES_URL, DATABASE_URL_UNPOOLED e POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgres://aragonez_app:aragonez_app@localhost:5432/aragonez
DATABASE_OWNER_URL=postgres://aragonez:aragonez@localhost:5432/aragonez
# DATABASE_RLS_ROLE=off   # desliga o papel automático (só se souber o que está fazendo)

# Autenticação (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3000

# Chave para criptografar segredos guardados no banco (ex.: chaves de IA por organização)
# 32 bytes em base64 (openssl rand -base64 32)
ENCRYPTION_KEY=

# Origens extras aceitas no login, separadas por vírgula (ex.: domínio próprio)
TRUSTED_ORIGINS=

# Armazenamento de arquivos:
#   local    = pasta no servidor (desenvolvimento)
#   s3       = S3, R2, MinIO, Supabase Storage S3
#   blob     = Vercel Blob em modo privado (BLOB_READ_WRITE_TOKEN ou OIDC com BLOB_STORE_ID)
#   database = no próprio Postgres (padrão na Vercel sem Blob/S3; até 4 MB por arquivo)
# Em branco: s3 se houver S3_BUCKET, blob se houver Vercel Blob, database na Vercel, local nos demais.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Limites de upload (podem ser reduzidos por organização nas configurações).
# Em branco: 100 MB, ou 4 MB na Vercel (limite de corpo das funções).
UPLOAD_MAX_BYTES=104857600
# Logo da agência: tamanho máximo do arquivo original (em branco: 5 MB, nunca acima do limite de upload).
LOGO_MAX_BYTES=

# E-mail (SMTP). Sem SMTP_HOST, os e-mails são exibidos no log do worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aragonez Builder <nao-responda@exemplo.com>"

# Inteligência artificial (opcional). Sem nenhuma chave, a IA fica "não configurada" (sem respostas simuladas).
# As chaves também podem ser cadastradas por agência em Configurações → Inteligência artificial.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Provedor inicial das novas agências. Em branco: o primeiro com chave (Anthropic, Gemini, OpenAI).
# "demo" ativa a demonstração local (respostas de exemplo, sempre identificadas) — útil só em desenvolvimento.
AI_DEFAULT_PROVIDER=

# Redis (Upstash) para o limite de tentativas do login. Opcional: sem ele, usa o banco.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Conta administradora criada no deploy (e-mail + senha de 8+ caracteres). Nunca altera
# a senha de uma conta existente. Essa conta cria agências sem a chave de acesso.
ARAGONEZ_ADMIN=
ARAGONEZ_ADMIN_PASS=

# Chave exigida para criar novas agências (aceita também o nome ACESS_KEY). Em branco: livre.
ACCESS_KEY=

# Processamento assíncrono
# Com worker contínuo: npm run worker (recomendado).
# Sem worker (ex.: Vercel): agende GET/POST /api/cron/tick com o cabeçalho
# "Authorization: Bearer <CRON_SECRET>" (a cada 1–5 min).
CRON_SECRET=
# Processa eventos e e-mails logo após cada operação, sem worker (padrão: true na Vercel).
EVENTS_INLINE=

# Migrações no build (npm run vercel-build). SKIP_DB_MIGRATE=1 pula.
SKIP_DB_MIGRATE=
