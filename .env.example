# ---------------------------------------------------------------
# Aragonez · variáveis de ambiente
# Copie para .env e ajuste. Nunca faça commit do .env.
# ---------------------------------------------------------------

# URL pública da aplicação (usada em links de e-mail e URLs assinadas)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aragonez

# Banco de dados
# DATABASE_URL: papel de execução, SEM superusuário e SEM BYPASSRLS (as políticas RLS se aplicam)
# DATABASE_OWNER_URL: papel dono das tabelas; usado só por migrações, seed e pelo worker (pg-boss)
DATABASE_URL=postgres://aragonez_app:aragonez_app@localhost:5432/aragonez
DATABASE_OWNER_URL=postgres://aragonez:aragonez@localhost:5432/aragonez

# Autenticação (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3000

# Chave para criptografar segredos guardados no banco (ex.: chaves de IA por organização)
# 32 bytes em base64 (openssl rand -base64 32)
ENCRYPTION_KEY=

# Armazenamento de arquivos: "local" (pasta no servidor) ou "s3" (S3, R2, MinIO, Supabase Storage S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Limites de upload (podem ser reduzidos por organização nas configurações)
UPLOAD_MAX_BYTES=104857600

# E-mail (SMTP). Sem SMTP_HOST, os e-mails são exibidos no log do worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aragonez <nao-responda@exemplo.com>"

# Inteligência artificial (opcional). Sem chave, o provedor "demo" responde localmente.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
